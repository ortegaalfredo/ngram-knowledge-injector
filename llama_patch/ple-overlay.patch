+// Apply the PLE n-gram knowledge overlay, if one is configured, by mapping the
+// patched rows MAP_PRIVATE over the model's read-only mapping. The GGUF on disk
+// is never written; only the pages that hold a patched row are copied.
+void llama_model_loader::apply_ple_overlay() {
+    // resolve the overlay lazily: LLAMA_PLE_OVERLAY env, else "<main>.plepatch"
+    if (ple_overlay.path.empty()) {
+        try {
+            ple_overlay = llama_ple_overlay_for_model(file_paths.empty() ? std::string() : file_paths.front());
+        } catch (const std::exception & ex) {
+            LLAMA_LOG_ERROR("%s: %s\n", __func__, ex.what());
+            throw;
+        }
+    }
+    if (ple_overlay.empty()) {
+        return;
+    }
+    if (!use_mmap) {
+        LLAMA_LOG_WARN("%s: PLE overlay requested but mmap is disabled - ignoring\n", __func__);
+        return;
+    }
+
+    const auto * w = get_weight(ple_overlay.tensor_name.c_str());
+    if (!w) {
+        LLAMA_LOG_WARN("%s: overlay targets tensor '%s' which this model does not have - ignoring\n",
+                       __func__, ple_overlay.tensor_name.c_str());
+        return;
+    }
+    if (w->idx >= file_paths.size() || w->idx >= mappings.size()) {
+        throw std::runtime_error("ple-overlay: shard bookkeeping is inconsistent");
+    }
+
+    const uint64_t data_off = w->offs;
+    const uint64_t n_rows   = (uint64_t) w->tensor->ne[1];
+
+    const size_t applied = llama_ple_overlay_apply(mappings.at(w->idx).get(), ple_overlay,
+                                                   file_paths.at(w->idx), data_off, n_rows);
+    LLAMA_LOG_INFO("%s: applied %zu PLE overlay row(s) to '%s' in %s\n",
+                  __func__, applied, ple_overlay.tensor_name.c_str(), file_paths.at(w->idx).c_str());
+}
