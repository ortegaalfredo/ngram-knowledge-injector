diff --git a/src/llama-ple-overlay.cpp b/src/llama-ple-overlay.cpp
new file mode 100644
index 000000000..f3547f82e
--- /dev/null
+++ b/src/llama-ple-overlay.cpp
@@ -0,0 +1,204 @@
+#include "llama-ple-overlay.h"
+
+#include "llama-impl.h"
+#include "llama-mmap.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+
+#include "ggml.h"
+
+#if defined(_POSIX_MAPPED_FILES) || defined(__unix__) || defined(__APPLE__)
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#define PLE_OVERLAY_POSIX 1
+#endif
+
+static uint16_t rd_u16(const uint8_t * p) { uint16_t v; std::memcpy(&v, p, 2); return v; }
+static uint32_t rd_u32(const uint8_t * p) { uint32_t v; std::memcpy(&v, p, 4); return v; }
+static uint64_t rd_u64(const uint8_t * p) { uint64_t v; std::memcpy(&v, p, 8); return v; }
+
+static const char * PLE_OVERLAY_ENV = "LLAMA_PLE_OVERLAY";
+
+llama_ple_overlay llama_ple_overlay_read_index(const char * path) {
+    llama_ple_overlay ov;
+    ov.path = path;
+
+    FILE * f = std::fopen(path, "rb");
+    if (!f) {
+        throw std::runtime_error(std::string("ple-overlay: cannot open ") + path);
+    }
+
+    uint8_t hdr[128];
+    if (std::fread(hdr, 1, sizeof(hdr), f) != sizeof(hdr) || std::memcmp(hdr, "PLEOVLY1", 8) != 0) {
+        std::fclose(f);
+        throw std::runtime_error(std::string("ple-overlay: bad magic in ") + path);
+    }
+
+    const uint16_t ver  = rd_u16(hdr + 8);
+    const uint32_t qtype = rd_u32(hdr + 12);
+    const uint64_t row_dim = rd_u64(hdr + 16);
+    const uint64_t bpr     = rd_u64(hdr + 24);
+    const uint64_t n_rows  = rd_u64(hdr + 32);
+    const uint64_t mlen    = rd_u64(hdr + 40);
+
+    if (ver != 1) {
+        std::fclose(f);
+        throw std::runtime_error(format("ple-overlay: unsupported version %u", ver));
+    }
+    if (bpr == 0 || row_dim == 0 || n_rows > (1ull << 32)) {
+        std::fclose(f);
+        throw std::runtime_error("ple-overlay: implausible header");
+    }
+
+    char name[65] = { 0 };
+    std::memcpy(name, hdr + 56, 64);
+    ov.tensor_name   = name;
+    ov.qtype         = qtype;
+    ov.row_dim       = row_dim;
+    ov.bytes_per_row = bpr;
+
+    if (std::fseek(f, (long) (128 + mlen), SEEK_SET) != 0) {
+        std::fclose(f);
+        throw std::runtime_error("ple-overlay: truncated manifest");
+    }
+
+    ov.rows.reserve(n_rows);
+    for (uint64_t i = 0; i < n_rows; i++) {
+        uint8_t rec[8];
+        if (std::fread(rec, 1, 8, f) != 8) {
+            std::fclose(f);
+            throw std::runtime_error("ple-overlay: truncated row index");
+        }
+        llama_ple_overlay_row r;
+        r.row = rd_u64(rec);
+        r.off = (size_t) std::ftell(f);   // payload follows the id
+        if (std::fseek(f, (long) bpr, SEEK_CUR) != 0) {
+            std::fclose(f);
+            throw std::runtime_error("ple-overlay: truncated row payload");
+        }
+        ov.rows.push_back(r);
+    }
+    std::fclose(f);
+
+    std::sort(ov.rows.begin(), ov.rows.end(),
+              [](const llama_ple_overlay_row & a, const llama_ple_overlay_row & b) {
+                  return a.row < b.row;
+              });
+    return ov;
+}
+
+llama_ple_overlay llama_ple_overlay_for_model(const std::string & model_path) {
+    const char * env = std::getenv(PLE_OVERLAY_ENV);
+    std::string path;
+    if (env && env[0]) {
+        path = env;
+    } else if (!model_path.empty()) {
+        path = model_path + ".plepatch";
+        FILE * probe = std::fopen(path.c_str(), "rb");
+        if (!probe) {
+            return {};  // nothing configured
+        }
+        std::fclose(probe);
+    } else {
+        return {};
+    }
+
+    llama_ple_overlay ov = llama_ple_overlay_read_index(path.c_str());
+    LLAMA_LOG_INFO("%s: loaded %zu patched row(s) from %s (tensor=%s qtype=%u row_dim=%llu)\n",
+                  __func__, ov.rows.size(), path.c_str(), ov.tensor_name.c_str(), ov.qtype,
+                  (unsigned long long) ov.row_dim);
+    return ov;
+}
+
+#ifdef PLE_OVERLAY_POSIX
+size_t llama_ple_overlay_apply(llama_mmap * mapping, const llama_ple_overlay & ov,
+                               const std::string & model_file, uint64_t data_off,
+                               uint64_t n_rows) {
+    if (ov.empty() || !mapping) {
+        return 0;
+    }
+
+    uint8_t * base = (uint8_t *) mapping->addr();
+    const size_t page = (size_t) sysconf(_SC_PAGESIZE);
+    const size_t bpr  = (size_t) ov.bytes_per_row;
+
+    // read the payloads first so the model fd stays closed while we map
+    std::vector<std::pair<uint64_t, std::vector<uint8_t>>> payloads;
+    payloads.reserve(ov.rows.size());
+    {
+        FILE * f = std::fopen(ov.path.c_str(), "rb");
+        if (!f) {
+            throw std::runtime_error("ple-overlay: cannot reopen " + ov.path);
+        }
+        for (const auto & r : ov.rows) {
+            if (r.row >= n_rows) {
+                std::fclose(f);
+                throw std::runtime_error(format("ple-overlay: row %llu outside the table (%llu rows)",
+                                                (unsigned long long) r.row, (unsigned long long) n_rows));
+            }
+            std::vector<uint8_t> buf(bpr);
+            if (std::fseek(f, (long) r.off, SEEK_SET) != 0 || std::fread(buf.data(), 1, bpr, f) != bpr) {
+                std::fclose(f);
+                throw std::runtime_error("ple-overlay: short row payload");
+            }
+            payloads.emplace_back(r.row, std::move(buf));
+        }
+        std::fclose(f);
+    }
+
+    const int fd = ::open(model_file.c_str(), O_RDONLY);
+    if (fd < 0) {
+        throw std::runtime_error("ple-overlay: cannot open model for COW overlay: " + model_file);
+    }
+
+    // Make each touched page MAP_PRIVATE over the read-only shared mapping. The
+    // kernel copies the page on first write, so the file on disk is never touched
+    // and every other reader of the mapping keeps seeing the original bytes.
+    //
+    // Pages are mapped one at a time and only once: re-mapping a page that is
+    // already private would discard a patch applied to a sibling row, and a row
+    // can straddle two pages.
+    size_t applied = 0;
+    std::vector<size_t> mapped_pages;   // sorted page offsets already made private
+
+    for (const auto & pl : payloads) {
+        const size_t off  = (size_t) data_off + (size_t) pl.first * bpr;
+        const size_t pstart = off & ~(page - 1);
+        const size_t pend   = (off + bpr + page - 1) & ~(page - 1);
+
+        for (size_t pg = pstart; pg < pend; pg += page) {
+            if (std::binary_search(mapped_pages.begin(), mapped_pages.end(), pg)) {
+                continue;
+            }
+            void * p = ::mmap(base + pg, page, PROT_READ | PROT_WRITE,
+                              MAP_PRIVATE | MAP_FIXED, fd, (off_t) pg);
+            if (p == MAP_FAILED) {
+                ::close(fd);
+                throw std::runtime_error(format("ple-overlay: COW overlay failed at page %zu: %s",
+                                                pg, strerror(errno)));
+            }
+            mapped_pages.insert(
+                std::lower_bound(mapped_pages.begin(), mapped_pages.end(), pg), pg);
+        }
+        std::memcpy(base + off, pl.second.data(), bpr);
+        applied++;
+    }
+    ::close(fd);
+    return applied;
+}
+#else
+size_t llama_ple_overlay_apply(llama_mmap * mapping, const llama_ple_overlay & ov,
+                               const std::string & model_file, uint64_t data_off,
+                               uint64_t n_rows) {
+    GGML_UNUSED(mapping); GGML_UNUSED(ov); GGML_UNUSED(model_file);
+    GGML_UNUSED(data_off); GGML_UNUSED(n_rows);
+    throw std::runtime_error("ple-overlay: not supported on this platform");
+}
+#endif
diff --git a/src/llama-ple-overlay.h b/src/llama-ple-overlay.h
new file mode 100644
index 000000000..683f7048d
--- /dev/null
+++ b/src/llama-ple-overlay.h
@@ -0,0 +1,46 @@
+#pragma once
+
+// PLE n-gram knowledge overlays.
+//
+// A .plepatch file produced by the ngram_tool injector carries replacement rows
+// for the per_layer_token_embd.weight table. Applying it as a MAP_PRIVATE
+// overlay on top of the model's read-only mapping keeps the GGUF on disk
+// byte-for-byte untouched and costs one 4 KiB page per patched row.
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+struct llama_file;
+struct llama_mmap;
+
+struct llama_ple_overlay_row {
+    uint64_t row;
+    size_t   off;   // byte offset of the row payload inside the overlay file
+};
+
+struct llama_ple_overlay {
+    std::string path;
+    std::string tensor_name;
+    std::string sha1_before;
+    uint32_t qtype = 0;
+    uint64_t row_dim = 0;
+    uint64_t bytes_per_row = 0;
+    std::vector<llama_ple_overlay_row> rows;  // sorted by row id
+
+    bool empty() const { return rows.empty(); }
+};
+
+// Parse the fixed 128-byte header plus the row index. Throws on a malformed file.
+llama_ple_overlay llama_ple_overlay_read_index(const char * path);
+
+// Resolve the overlay for a model: LLAMA_PLE_OVERLAY env var, else a sibling
+// "<model>.plepatch". Returns an empty overlay when nothing is configured.
+llama_ple_overlay llama_ple_overlay_for_model(const std::string & model_path);
+
+// Overlay the patched rows of `ov` onto an existing read-only mapping of
+// `model_file` (the shard that holds the table). Returns rows applied.
+size_t llama_ple_overlay_apply(llama_mmap * mapping, const llama_ple_overlay & ov,
+                               const std::string & model_file,
+                               uint64_t data_off, uint64_t n_rows);
